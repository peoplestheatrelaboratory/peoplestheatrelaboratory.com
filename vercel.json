{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install --frozen-lockfile",
  "cleanUrls": true,
  "trailingSlash": true,
  "crons": [{ "path": "/api/nightly-rebuild/", "schedule": "30 21 * * *" }]
}
