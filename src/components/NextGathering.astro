---
/**
 * The owner's rule: the upcoming event *is* the home page. This is the strip
 * under the video that says so — one gathering, its date, and a way in.
 * When nothing is scheduled it points at the ledger instead of going quiet.
 */
import MoonPhase from './MoonPhase.astro';
import { upcomingEvents, pastEvents, formatDate, formatPlace, seriesOf } from '../lib/content';
import { SITE } from '../consts';

const next = upcomingEvents()[0];
const last = pastEvents()[0];
const e = next ?? last;
---

{e && (
  <section class="next" aria-label={next ? 'Next gathering' : 'Last gathering'}>
    <div class="page next__inner">
      <p class="eyebrow">{next ? 'Next gathering' : 'Last gathering'} · {seriesOf(e).label}</p>
      <h2>
        <a href={`/events/${e.slug}/`}>{e.title}</a>
        {e.titleDeva && <span class="deva" lang="hi">{e.titleDeva}</span>}
      </h2>
      <p class="when"><MoonPhase date={e.date} /> {formatDate(e.date, e.tithi)} · {formatPlace(e)}</p>
      <p class="summary">{e.summary}</p>
      <p class="actions">
        {next ? (
          <a class="cta" href={e.registerUrl || SITE.phoneHref}>{e.registerUrl ? 'Book a seat →' : `Call ${SITE.phone}`}</a>
        ) : (
          <a class="cta" href={`/events/${e.slug}/`}>What was sung →</a>
        )}
        <a class="all" href="/events/">All gatherings</a>
      </p>
    </div>
  </section>
)}

<style>
  .next {
    --moon-lit: var(--ink);
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--space-2xl);
    border-block-start: 1px solid var(--paper-18);
  }

  .next__inner { max-width: var(--measure); margin-inline: auto; }

  .next h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-m);
    margin-block: var(--space-s) var(--space-s);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-4);
    line-height: var(--leading-tight);
  }

  .next h2 a { color: inherit; text-decoration: none; }
  .next h2 a:hover { color: var(--ember); }
  .next h2 .deva { color: var(--ember); font-size: var(--step-2); }

  .when {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--paper-60);
  }

  .summary { margin-block-start: var(--space-m); font-size: var(--step-1); line-height: var(--leading-body); color: var(--paper-72); }

  .actions { display: flex; flex-wrap: wrap; gap: var(--space-m) var(--space-l); align-items: baseline; margin-block-start: var(--space-l); }
  .cta { font-family: var(--font-mono); letter-spacing: var(--tracking-wide); text-transform: uppercase; text-decoration: none; color: var(--ember); }
  .all { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: var(--tracking-wide); text-transform: uppercase; text-decoration: none; color: var(--paper-38); }
  .all:hover { color: var(--paper); }
</style>
