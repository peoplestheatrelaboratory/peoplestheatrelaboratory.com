---
import InteriorLayout from '../../../layouts/InteriorLayout.astro';
import SongSheet from '../../../components/SongSheet.astro';
import { songs, getSong, getArtist } from '../../../lib/content';

export function getStaticPaths() {
  return songs.map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const song = getSong(slug!)!;
const poets = song.poets.map((p) => getArtist(p)).filter(Boolean);

// neighbours within the same poet, else the whole list
const pool = poets.length ? songs.filter((s) => s.poets[0] === song.poets[0]) : songs;
const i = pool.findIndex((s) => s.slug === song.slug);
const prev = pool[i - 1];
const next = pool[i + 1];
const href = (s: { slug: string }) => `/library/songs/${s.slug}/`;
---

<InteriorLayout
  title={song.title}
  eyebrow={poets.length ? poets.map((p) => p!.name).join(' · ') : 'song'}
  deva={song.titleLatin}
  description={`${song.titleLatin || song.title}${poets.length ? ` — ${poets.map((p) => p!.name).join(', ')}` : ''}. Lyrics${song.meaning ? ' and meaning' : ''}, as sung at Peoples Theatre Laboratory.`}
>
  <SongSheet
    song={song}
    prev={prev && { href: href(prev), title: prev.title }}
    next={next && { href: href(next), title: next.title }}
    back={{ href: '/library/songs/', label: 'All songs' }}
  />
</InteriorLayout>
