---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroVideo from '../components/HeroVideo.astro';
import NextGathering from '../components/NextGathering.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSiteSettings } from '../lib/site-settings';
import { getContent } from '../lib/content';
const [settings, { featuredGathering }] = await Promise.all([getSiteSettings(Astro.locals), getContent(Astro.locals)]);
// The hero's cue scrolls to the gathering strip, so it only shows when that strip renders.
const hasGathering = Boolean(featuredGathering(settings));
---

<BaseLayout description={settings.description}>
  <SiteHeader overlay />
  <main id="main">
    <h1 class="visually-hidden">
      {settings.heading}
    </h1>
    <HeroVideo couplet={settings.couplet} translation={settings.translation} attribution={settings.attribution} poster={settings.poster} variants={settings.videoVariants} cueLabel={settings.nextLabel} showCue={hasGathering} />
    <NextGathering />
  </main>
  <SiteFooter />
</BaseLayout>
