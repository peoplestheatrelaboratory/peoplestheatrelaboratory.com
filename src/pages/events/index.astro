---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import MoonPhase from '../../components/MoonPhase.astro';
import { getUpcoming, getPast, formatDate, formatPlace, SERIES } from '../../lib/events';
import { SITE } from '../../consts';

const upcoming = getUpcoming();
const past = getPast();

// group the ledger by year; undated entries go under their own heading
const years = new Map<string, typeof past>();
for (const e of past) {
  const y = e.date ? e.date.slice(0, 4) : 'undated';
  years.set(y, [...(years.get(y) ?? []), e]);
}
---

<InteriorLayout
  title="Events"
  eyebrow="when we gather"
  deva="बैठक"
  description={`Gatherings of Peoples Theatre Laboratory, ${SITE.city} — the monthly Baithak and the annual Kabir Sang Ruhdaari.`}
>
  <section class="next">
    {upcoming.length ? (
      upcoming.map((e) => (
        <article class="next__card">
          <p class="eyebrow">Next · {SERIES[e.series].label}</p>
          <h2><a href={`/events/${e.slug}/`}>{e.title}</a></h2>
          <p class="when"><MoonPhase date={e.date} /> {formatDate(e.date, e.tithi)} · {formatPlace(e)}</p>
          <p class="summary">{e.summary}</p>
          {e.registerUrl && <a class="cta" href={e.registerUrl}>Register →</a>}
        </article>
      ))
    ) : (
      <article class="next__card next__card--empty">
        <p class="eyebrow">Next</p>
        <h2>The next <span class="deva" lang="hi">बैठक</span> is being planned.</h2>
        <p class="summary">
          We gather roughly every month, on or near the full moon. Call{' '}
          <a href={SITE.phoneHref}>{SITE.phone}</a> or message us on Instagram and
          we'll tell you where the next one is.
        </p>
      </article>
    )}
  </section>

  <section class="ledger">
    <h2>Past gatherings</h2>
    {[...years.entries()].map(([year, list]) => (
      <div class="year">
        <h3 class="year__label">{year === 'undated' ? 'Earlier' : year}</h3>
        <ol class="rows" role="list">
          {list.map((e) => (
            <li>
              <a class="row" href={`/events/${e.slug}/`}>
                <MoonPhase date={e.date} size={26} class="row__moon" />
                <span class="row__when">{formatDate(e.date, e.tithi)}</span>
                <span class="row__title">
                  <span class="row__latin">{e.title}</span>
                  <span class="row__deva deva" lang="hi">{e.titleDeva}</span>
                </span>
                <span class="row__where">{formatPlace(e)}</span>
                <span class="row__songs">{e.setlist.length} songs</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <section class="rhythm">
    <h2>Two rhythms</h2>
    <ul role="list">
      <li>
        <MoonPhase date={null} size={40} />
        <div>
          <h3><span class="deva" lang="hi">{SERIES.baithak.deva}</span> {SERIES.baithak.label}</h3>
          <p>Monthly, mostly on a Poornima. Homes, studios and courtyards — a room small enough that nobody is only an audience.</p>
        </div>
      </li>
      <li>
        <MoonPhase date={null} size={40} />
        <div>
          <h3><span class="deva" lang="hi">{SERIES.ksr.deva}</span> {SERIES.ksr.label}</h3>
          <p>Once a year on Jyestha Poornima, Kabir's birthday. Contribution-based, limited seating, live painting. Not a presentation — a shared space of reflection.</p>
        </div>
      </li>
    </ul>
  </section>
</InteriorLayout>

<style>
  /* ── next ──────────────────────────────────────────────────────── */
  .next__card {
    max-width: var(--measure);
    padding: var(--space-l) var(--space-l) var(--space-l) var(--space-xl);
    border-inline-start: 2px solid var(--ember);
  }

  .next__card h2 {
    margin-block: var(--space-s) var(--space-s);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-3);
    line-height: var(--leading-tight);
  }

  .next__card h2 a { color: inherit; text-decoration: none; }
  .next__card h2 a:hover { color: var(--ember); }
  .next__card h2 .deva { color: var(--ember); }

  .when {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .summary {
    margin-block-start: var(--space-m);
    font-size: var(--step-1);
    line-height: var(--leading-body);
    color: var(--fg-muted);
  }

  .summary a {
    color: var(--fg);
    text-decoration: none;
    border-block-end: 1px solid var(--ink-38);
    white-space: nowrap;
  }
  .summary a:hover { color: var(--ember); border-block-end-color: var(--ember); }

  .cta {
    display: inline-block;
    margin-block-start: var(--space-m);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ember);
  }

  /* ── ledger ────────────────────────────────────────────────────── */
  .year + .year { margin-block-start: var(--space-xl); }

  .year__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-block-end: var(--space-s);
  }

  .rows { margin: 0; padding: 0; }

  .row {
    display: grid;
    grid-template-columns: auto 15rem 1fr 14rem 6rem;
    align-items: baseline;
    column-gap: var(--space-l);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .rows li:last-child .row { border-block-end: 1px solid var(--rule); }

  .row:hover .row__latin,
  .row:focus-visible .row__latin { color: var(--ember); }

  .row__moon { align-self: center; color: var(--fg); }

  .row__when,
  .row__songs {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .row__songs { text-align: end; }

  .row__title { display: flex; flex-direction: column; gap: 0.15rem; }

  .row__latin {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: var(--leading-tight);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .row__deva { font-size: var(--step-0); color: var(--ember); }

  .row__where { color: var(--fg-muted); }

  @media (max-width: 56rem) {
    .row {
      grid-template-columns: auto 1fr;
      row-gap: 0.35rem;
    }
    .row__moon { grid-row: 1 / 3; }
    .row__when, .row__where, .row__songs { grid-column: 2; text-align: start; }
    .row__title { grid-column: 2; }
  }

  /* ── rhythms ───────────────────────────────────────────────────── */
  .rhythm ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-xl) var(--space-l);
    margin: 0;
    padding: 0;
  }

  .rhythm li { display: flex; gap: var(--space-m); align-items: flex-start; color: var(--fg); }

  .rhythm h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-xs) var(--space-s);
    margin-block-end: var(--space-s);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
    line-height: var(--leading-tight);
  }

  .rhythm h3 .deva { color: var(--ember); }

  .rhythm p { max-width: 40ch; color: var(--fg-muted); line-height: var(--leading-body); }
</style>
