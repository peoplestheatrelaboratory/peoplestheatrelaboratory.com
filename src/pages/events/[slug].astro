---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import MoonPhase from '../../components/MoonPhase.astro';
import {
  eventsSorted, getEvent, getSong, getArtist, formatDate, formatPlace, seriesOf, isUpcoming, poetNames,
} from '../../lib/content';
import { SITE } from '../../consts';

export function getStaticPaths() {
  return eventsSorted().map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const event = getEvent(slug!)!;
const series = seriesOf(event);
const upcoming = isUpcoming(event);

// neighbours for the earlier/later links, in date order
const all = eventsSorted();
const i = all.findIndex((e) => e.slug === event.slug);
const newer = all[i - 1];
const older = all[i + 1];

const setlist = event.setlist.map((s) => getSong(s)).filter(Boolean);
const performers = event.artists.map((a) => getArtist(a)).filter(Boolean);
---

<InteriorLayout
  title={event.title}
  eyebrow={[series.label, series.rhythm].filter(Boolean).join(' · ')}
  deva={event.titleDeva}
  description={`${event.title} — ${formatDate(event.date, event.tithi)}, ${formatPlace(event)}. ${event.summary}`}
  image={event.cover || undefined}
>
  {event.cover && <img class="cover" src={event.cover} alt="" />}

  <section class="facts">
    <dl>
      <div>
        <dt>When</dt>
        <dd><MoonPhase date={event.date} /> {formatDate(event.date, event.tithi)}</dd>
      </div>
      <div>
        <dt>Where</dt>
        <dd>{event.venue && event.venue !== event.city ? <>{event.venue}<br />{event.city}</> : event.city}</dd>
      </div>
      <div>
        <dt>Sitting</dt>
        <dd>
          {upcoming
            ? 'Limited seating · contribution-based'
            : `Concluded${setlist.length ? ` · ${setlist.length} songs sung` : ''}`}
        </dd>
      </div>
    </dl>
    {upcoming && (
      <a class="cta" href={event.registerUrl || SITE.phoneHref}>
        {event.registerUrl ? 'Register →' : `Call ${SITE.phone} to reserve a seat`}
      </a>
    )}
  </section>

  <section class="prose">
    {event.body ? <Fragment set:html={event.body} /> : <p>{event.summary}</p>}
  </section>

  {setlist.length > 0 && (
    <section class="setlist">
      <h2>{upcoming ? 'Songs we will sing' : 'What was sung'}</h2>
      <ol role="list">
        {setlist.map((s, n) => (
          <li>
            <span class="n">{String(n + 1).padStart(2, '0')}</span>
            <a class="song" href={`/library/songs/${s!.slug}/`}>
              <span class="song__title" lang="hi">{s!.title}</span>
              <span class="song__poet">{poetNames(s!)}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  {performers.length > 0 && (
    <section class="voices">
      <h2>Voices in the room</h2>
      <ul role="list">
        {performers.map((a) => (
          <li>
            <a href={`/library/artists/${a!.slug}/`}>{a!.name}</a>
            {a!.nameDeva && <span class="deva" lang="hi">{a!.nameDeva}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <nav class="neighbours" aria-label="Other gatherings">
    {older && <a href={`/events/${older.slug}/`}><span class="eyebrow">Earlier</span>{older.title}</a>}
    <a class="all" href="/events/">All gatherings</a>
    {newer && <a class="later" href={`/events/${newer.slug}/`}><span class="eyebrow">Later</span>{newer.title}</a>}
  </nav>
</InteriorLayout>

<style>
  .cover {
    display: block;
    width: 100%;
    max-height: 60vh;
    object-fit: cover;
    margin-block-end: var(--space-xl);
    filter: sepia(0.25) contrast(1.05);
  }

  .facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-l);
    margin: 0;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .facts dd {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: var(--space-xs) 0 0;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .cta {
    display: inline-block;
    margin-block-start: var(--space-l);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ember);
  }

  /* ── setlist: numbered because the order is the order they were sung ── */
  .setlist ol {
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-xl);
  }

  .setlist li {
    display: flex;
    gap: var(--space-m);
    align-items: baseline;
    padding-block: 0.55rem;
    border-block-start: 1px solid var(--rule);
    break-inside: avoid;
  }

  .n {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-faint);
  }

  .song { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .song:hover .song__title { color: var(--ember); }
  .song__title { font-size: var(--step-1); line-height: 1.4; transition: color var(--dur-fast) var(--ease-out); }
  .song__poet { font-size: var(--step--1); color: var(--fg-faint); }

  @media (max-width: 40rem) { .setlist ol { columns: 1; } }

  /* ── voices ───────────────────────────────────────────────────── */
  .voices ul { display: flex; flex-wrap: wrap; gap: var(--space-s) var(--space-l); margin: 0; padding: 0; }
  .voices li { display: flex; gap: 0.5rem; align-items: baseline; }
  .voices a { color: inherit; text-decoration: none; border-block-end: 1px solid var(--ink-38); }
  .voices a:hover { color: var(--ember); border-block-end-color: var(--ember); }
  .voices .deva { color: var(--fg-faint); font-size: var(--step--1); }

  /* ── neighbours ────────────────────────────────────────────────── */
  .neighbours {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-l);
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--rule);
  }

  .neighbours a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: var(--leading-tight);
    text-decoration: none;
    color: inherit;
  }

  .neighbours a:hover { color: var(--ember); }
  .neighbours .later { grid-column: 3; text-align: end; align-items: flex-end; }
  .neighbours .all {
    grid-column: 2;
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  @media (max-width: 40rem) {
    .neighbours { grid-template-columns: 1fr; }
    .neighbours .later, .neighbours .all { grid-column: 1; text-align: start; align-items: flex-start; }
  }
</style>
