---
import InteriorLayout from '../../../layouts/InteriorLayout.astro';
import MoonPhase from '../../../components/MoonPhase.astro';
import {
  eventsSorted, getEvent, getSong, getArtist, formatDate, formatPlace, seriesOf, isUpcoming, poetNames, isGujarati,
} from '../../../lib/content';
import { SITE } from '../../../consts';

export function getStaticPaths() {
  return eventsSorted().map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const event = getEvent(slug!)!;
const series = seriesOf(event);
const upcoming = isUpcoming(event);

const setlist = event.setlist.map((s) => getSong(s)).filter(Boolean);
const performers = event.artists.map((a) => getArtist(a)).filter(Boolean);
---

<InteriorLayout
  title={event.title}
  eyebrow={[series.label, series.rhythm].filter(Boolean).join(' · ')}
  deva={event.titleDeva}
  description={`${event.title} — ${formatDate(event.date, event.tithi)}, ${formatPlace(event)}. ${event.summary}`}
  image={event.cover || undefined}
>
  {event.cover && <img class="cover" src={event.cover} alt="" />}

  <section class="facts">
    <dl>
      <div>
        <dt>When</dt>
        <dd><MoonPhase date={event.date} /> {formatDate(event.date, event.tithi)}</dd>
      </div>
      <div>
        <dt>Where</dt>
        <dd>{event.venue && event.venue !== event.city ? <>{event.venue}<br />{event.city}</> : event.city}</dd>
      </div>
    </dl>
    {upcoming && (
      <a class="cta" href={event.registerUrl || SITE.phoneHref}>
        {event.registerUrl ? 'Register →' : `Call ${SITE.phone} to reserve a seat`}
      </a>
    )}
  </section>

  <section class="prose">
    {event.body ? <Fragment set:html={event.body} /> : <p>{event.summary}</p>}
  </section>

  {/* Before the gathering the setlist stays closed — only a way in. After it,
      the songs themselves are the record of what happened. */}
  {setlist.length > 0 && (
    upcoming ? (
      <section class="setlist">
        <a class="cta songbook" href={`/events/${event.slug}/lyrics/`}>Open songbook →</a>
      </section>
    ) : (
      <section class="setlist">
        <h2>What was sung</h2>
        <ol role="list">
          {setlist.map((s, n) => {
            const isGuj = isGujarati(s!.title);
            return (
              <li>
                <span class="n">{String(n + 1).padStart(2, '0')}</span>
                <a class="song" href={`/events/${event.slug}/lyrics/${s!.slug}/`}>
                  <span class:list={['song__title', { guj: isGuj, deva: !isGuj }]} lang={isGuj ? 'gu' : 'hi'}>{s!.title}</span>
                  <span class="song__poet">{poetNames(s!)}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </section>
    )
  )}

  {performers.length > 0 && (
    <section class="artists">
      <h2>Artists</h2>
      <ul role="list">
        {performers.map((a) => (
          <li>
            {a!.photo && <img src={a!.photo} alt="" loading="lazy" />}
            <div>
              <a class="name" href={`/library/artists/${a!.slug}/`}>{a!.name}</a>
              {a!.nameDeva && <span class="deva" lang="hi">{a!.nameDeva}</span>}
              <span class="role">{a!.roles.join(' · ')}</span>
              {a!.link && <a class="link" href={a!.link} rel="noopener" target="_blank">{a!.link.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}
</InteriorLayout>

<style>
  .cover {
    display: block;
    width: 100%;
    max-height: 60vh;
    object-fit: cover;
    margin-block-end: var(--space-xl);
    filter: sepia(0.25) contrast(1.05);
  }

  .facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-l);
    margin: 0;
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .facts dd {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: var(--space-xs) 0 0;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  .cta {
    display: inline-block;
    margin-block-start: var(--space-l);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ember);
  }

  /* ── setlist: numbered because the order is the order they were sung ── */
  .setlist ol {
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-xl);
  }

  .setlist li {
    display: flex;
    gap: var(--space-m);
    align-items: baseline;
    padding-block: 0.55rem;
    border-block-start: 1px solid var(--rule);
    break-inside: avoid;
  }

  .n {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--fg-faint);
  }

  .song { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .song:hover .song__title { color: var(--ember); }
  .song__title { font-size: var(--step-1); line-height: 1.4; transition: color var(--dur-fast) var(--ease-out); }
  .song__title.guj { font-family: var(--font-guj); }
  .song__poet { font-size: var(--step--1); color: var(--fg-faint); }

  @media (max-width: 40rem) { .setlist ol { columns: 1; } }

  /* alone in its section on an upcoming gathering — no heading to sit under */
  .songbook { margin-block: 0; font-size: var(--step-1); }

  /* ── artists ──────────────────────────────────────────────────── */
  .artists ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: var(--space-l); margin: 0; padding: 0; }
  .artists li { display: flex; gap: var(--space-m); align-items: flex-start; }
  .artists img { width: 4.5rem; aspect-ratio: 1; object-fit: cover; border-radius: 50%; filter: sepia(0.3); flex: none; }
  .artists div { display: flex; flex-direction: column; gap: 0.15rem; }
  .artists .name { font-family: var(--font-display); font-size: var(--step-1); color: inherit; text-decoration: none; }
  .artists .name:hover { color: var(--ember); }
  .artists .deva { color: var(--ember); font-size: var(--step--1); }
  .artists .role { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-faint); }
  .artists .link { margin-block-start: 0.2rem; font-size: var(--step--1); color: var(--fg-muted); text-decoration: none; border-block-end: 1px solid var(--ink-38); align-self: flex-start; }
  .artists .link:hover { color: var(--ember); border-block-end-color: var(--ember); }
</style>
