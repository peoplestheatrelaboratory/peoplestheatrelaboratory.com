---
import InteriorLayout from '../../../../layouts/InteriorLayout.astro';
import SongSheet from '../../../../components/SongSheet.astro';
import { getContent } from '../../../../lib/content';
const { getEvent, getSong, getArtist } = await getContent(Astro.locals);



const { slug, song: songSlug } = Astro.params;
const event = getEvent(slug!);
if (!event) return Astro.rewrite("/404/");
const song = getSong(songSlug!);
if (!song) return Astro.rewrite("/404/");
if (!event.setlist.includes(song.slug)) return Astro.rewrite("/404/");
const order = event.setlist.filter((s) => getSong(s));
const i = order.indexOf(song.slug);
const prev = i > 0 ? getSong(order[i - 1]) : undefined;
const next = i < order.length - 1 ? getSong(order[i + 1]) : undefined;
const href = (s: { slug: string }) => `/events/${event.slug}/lyrics/${s.slug}/`;
const poets = song.poets.map((p) => getArtist(p)?.name).filter(Boolean).join(' · ');
---

<InteriorLayout
  title={song.title}
  romanTitle={song.titleLatin && song.titleLatin !== song.title ? song.titleLatin : undefined}
  eyebrow={`${event.title} · ${poets || 'song'}`}
  description={`${song.titleLatin || song.title} — song ${i + 1} of ${order.length} at ${event.title}. Lyrics to sing along.`}
>
  <SongSheet
    song={song}
    position={{ n: i + 1, of: order.length }}
    prev={prev && { href: href(prev), title: prev.title }}
    next={next && { href: href(next), title: next.title }}
    back={{ href: `/events/${event.slug}/lyrics/`, label: 'Songbook' }}
  />
</InteriorLayout>
