---
import InteriorLayout from '../../../../layouts/InteriorLayout.astro';
import { eventsSorted, getEvent, getSong, poetNames, formatDate, formatPlace } from '../../../../lib/content';

export function getStaticPaths() {
  return eventsSorted().filter((e) => e.setlist.length).map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const event = getEvent(slug!)!;
const setlist = event.setlist.map((s) => getSong(s)).filter(Boolean);
---

<InteriorLayout
  title="Songbook"
  eyebrow={`${event.title} · ${formatDate(event.date, event.tithi)}`}
  deva="गीत"
  description={`The ${setlist.length} songs of ${event.title}, ${formatPlace(event)}, in the order they are sung — with lyrics to sing along.`}
>
  <p class="lead">
    Open the first song and use <kbd>→</kbd> <kbd>←</kbd> (or the links at the
    bottom) to move through the evening in order.
  </p>

  <ol class="setlist" role="list">
    {setlist.map((s, n) => (
      <li>
        <a href={`/events/${event.slug}/lyrics/${s!.slug}/`}>
          <span class="n">{String(n + 1).padStart(2, '0')}</span>
          <span class="t" lang="hi">{s!.title}</span>
          <span class="p">{poetNames(s!)}</span>
        </a>
      </li>
    ))}
  </ol>

  <p class="back"><a href={`/events/${event.slug}/`}>← {event.title}</a></p>
</InteriorLayout>

<style>
  .lead { max-width: var(--measure); margin-block-end: var(--space-xl); color: var(--fg-muted); }
  kbd { font-family: var(--font-mono); font-size: 0.85em; padding: 0 0.35em; border: 1px solid var(--rule); border-radius: 3px; }

  .setlist { max-width: var(--measure); margin: 0; padding: 0; }
  .setlist a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: var(--space-m);
    padding-block: var(--space-s);
    border-block-start: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }
  .setlist li:last-child a { border-block-end: 1px solid var(--rule); }
  .setlist a:hover .t { color: var(--ember); }
  .n { grid-row: 1 / 3; font-family: var(--font-mono); font-size: var(--step--1); color: var(--fg-faint); align-self: center; }
  .t { font-size: var(--step-2); line-height: 1.35; transition: color var(--dur-fast) var(--ease-out); }
  .p { font-size: var(--step--1); color: var(--fg-faint); }

  .back { margin-block-start: var(--space-2xl); font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .back a { color: var(--fg-faint); text-decoration: none; }
  .back a:hover { color: var(--ember); }
</style>
