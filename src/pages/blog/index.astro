---
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import { posts, team, formatDate } from '../../lib/content';
import { SOCIALS } from '../../consts';

const authorName = (slug: string) => team.find((t) => t.slug === slug)?.name ?? '';
---

<InteriorLayout
  title="Blog"
  eyebrow="notes from the room"
  deva="टिप्पणियाँ"
  description="Notes from Peoples Theatre Laboratory — what happened at the last gathering, what is being rehearsed, what we are reading."
>
  {posts.length ? (
    <ol class="posts" role="list">
      {posts.map((p) => (
        <li>
          <a class="post" href={`/blog/${p.slug}/`}>
            {p.cover && <img src={p.cover} alt="" loading="lazy" />}
            <span class="post__meta">{formatDate(p.date)}{p.authors.length ? ` · ${p.authors.map(authorName).filter(Boolean).join(', ')}` : ''}</span>
            <span class="post__title">{p.title}</span>
            {p.excerpt && <span class="post__excerpt">{p.excerpt}</span>}
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <section class="prose empty">
      <p>
        Nothing written down yet — the room has been busy singing. Until the first
        note lands here, the freshest word is on
        <a href={SOCIALS[0].href} rel="me noopener">Instagram</a>.
      </p>
    </section>
  )}
</InteriorLayout>

<style>
  .posts { display: grid; gap: var(--space-xl); margin: 0; padding: 0; max-width: var(--measure); }
  .post { display: grid; gap: var(--space-xs); text-decoration: none; color: inherit; }
  .post img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-block-end: var(--space-s); filter: sepia(0.25); }
  .post__meta { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em; color: var(--fg-faint); }
  .post__title { font-family: var(--font-display); font-size: var(--step-3); line-height: var(--leading-tight); transition: color var(--dur-fast) var(--ease-out); }
  .post:hover .post__title { color: var(--ember); }
  .post__excerpt { font-size: var(--step-1); color: var(--fg-muted); line-height: var(--leading-body); }
  .empty p { color: var(--fg-muted); }
</style>
