{
  "name": "@ptl/admin",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "check": "tsc --noEmit",
    "payload": "payload",
